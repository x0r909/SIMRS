# Salin ke .env.production sebelum deploy:
#   cp .env.production.example .env.production
#
# Generate secret (jalankan 3x untuk JWT + encryption):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# Gateway nginx — satu-satunya port yang diekspos ke host/LAN
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443
# CN sertifikat self-signed (isi IP laptop agar browser lebih mudah menerima)
# Contoh: NGINX_SSL_CN=192.168.1.10
NGINX_SSL_CN=simrs.local
# true = semua HTTP (:80) dialihkan ke HTTPS (:443)
NGINX_REDIRECT_HTTP_TO_HTTPS=false

# Database
POSTGRES_DB=simrs
POSTGRES_USER=simrs
POSTGRES_PASSWORD=GANTI_dengan_password_kuat

# Redis (internal — tidak perlu expose port)

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=GANTI_dengan_password_kuat
MINIO_BUCKET=simrs

# JWT & enkripsi (WAJIB diganti di produksi)
JWT_ACCESS_SECRET=GANTI_dengan_secret_min_16_karakter
JWT_REFRESH_SECRET=GANTI_dengan_secret_min_16_karakter
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800

ENCRYPTION_KEY=GANTI_base64_32_bytes
ENCRYPTION_SEARCH_KEY=GANTI_base64_32_bytes
BACKUP_ENCRYPTION_KEY=GANTI_base64_32_bytes

# CORS — daftar origin dipisah koma, atau * untuk semua
CORS_ORIGIN=*

# URL publik untuk build frontend (via nginx, tanpa port backend)
# Browser memanggil API di /v1 pada host yang sama.
# Untuk akses LAN: http://<IP-laptop> — rebuild image jika diubah.
NEXT_PUBLIC_API_URL=http://localhost

# Database seed saat pertama kali deploy (set false setelah production stabil)
SEED_DATABASE=true

# Password semua akun seed (admin, staff, pasien) — min. 12 karakter
SEED_DEFAULT_PASSWORD=GANTI_dengan_password_kuat_min_12_karakter

# Opsional
PROMETHEUS_METRICS_ENABLED=true
LOG_LEVEL=info
SWAGGER_PATH=docs
