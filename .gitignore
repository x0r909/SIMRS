# =============================================================================
# SIMRS — Git ignore (development, production, GitHub)
# =============================================================================

# ── Dependencies ─────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/sdks
!.yarn/versions

# ── Build & cache ────────────────────────────────────────────────────────────
.next/
out/
dist/
build/
coverage/
.turbo/
*.tsbuildinfo
.eslintcache
.nyc_output/

# ── Logs ─────────────────────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ── Environment & secrets (commit hanya file *.example) ───────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development
.env.test

# Pola umum — lalu whitelist file contoh
.env.*
!.env.example
!.env.production.example

**/.env
**/.env.local
**/.env.*.local
**/.env.production
**/.env.*
!**/.env.example
!**/.env.production.example

# Credential / dump lokal (jangan commit ke GitHub)
example-db.txt
packages/db/loginreq.json
secrets/
*.pem
*.key
*.p12
*.crt
!docker/nginx/certs/.gitkeep

# ── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Editors & IDEs ───────────────────────────────────────────────────────────
.idea/
*.swp
*.swo
*~
*.code-workspace
.vscode/*
!.vscode/extensions.json

# Cursor / AI local state
.cursor/
.agent-transcripts/
.claude/

# ── Runtime & generated data ─────────────────────────────────────────────────
apps/backend/backups/
backups/
uploads/
tmp/
temp/
*.tmp
*.bak
*.backup
*.pid

# ── Database local files & dumps ─────────────────────────────────────────────
*.sqlite
*.sqlite3
*.db
*.db-journal
*.sql.gz
*.dump
prisma/*.db

# ── Docker ───────────────────────────────────────────────────────────────────
docker-compose.override.yml
.docker/

# nginx TLS — generate lokal (lihat docker/scripts/generate-nginx-certs.sh)
docker/nginx/certs/*.pem
docker/nginx/certs/*.key

# Volume data lokal (jika bind-mount)
data/postgres/
data/redis/
data/minio/
minio-data/

# ── Test & coverage artifacts ────────────────────────────────────────────────
junit.xml
test-results/
playwright-report/
playwright/.cache/

# ── Deployment platforms ─────────────────────────────────────────────────────
.vercel/
.netlify/

# ── Monitoring stack (data persist lokal) ────────────────────────────────────
monitoring/grafana-data/
monitoring/prometheus-data/
monitoring/loki-data/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.orig
